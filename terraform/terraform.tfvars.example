# Azure Configuration
resource_group_name = "k8s-dev-rg"
location            = "eastus"
environment         = "dev"

# Network Configuration
vnet_address_space     = ["10.0.0.0/16"]
subnet_address_prefix  = "10.0.1.0/24"

# VM Configuration
admin_username         = "azureuser"
ssh_public_key_path    = "~/.ssh/id_rsa.pub"  # Update this path to your SSH public key
control_plane_vm_size  = "Standard_D2s_v3"
worker_vm_size         = "Standard_E2s_v3"
worker_count           = 2
disk_size_gb           = 50

# Storage Configuration
storage_account_tier        = "Standard"
storage_account_replication = "LRS"

# Tags
tags = {
  Environment = "dev"
  Project     = "kubernetes-cluster"
  ManagedBy   = "terraform"
  Owner       = "your-name"  # Update this
}
