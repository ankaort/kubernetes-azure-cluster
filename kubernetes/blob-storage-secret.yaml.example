---
# Example: Blob Storage Secret
# This is a template - replace with your actual values from Terraform outputs
apiVersion: v1
kind: Secret
metadata:
  name: azure-storage-secret
  namespace: default
type: Opaque
stringData:
  azurestorageaccountname: "<STORAGE_ACCOUNT_NAME>"  # From terraform output: storage_account_name
  azurestorageaccountkey: "<STORAGE_ACCOUNT_KEY>"    # From terraform output: storage_account_primary_key
---
# Example: ConfigMap with Storage Account Information
apiVersion: v1
kind: ConfigMap
metadata:
  name: azure-storage-config
  namespace: default
data:
  storage_account_name: "<STORAGE_ACCOUNT_NAME>"
  storage_container_name: "kubernetes-data"
  # Connection string format (if needed for SDKs)
  # DefaultEndpointsProtocol=https;AccountName=<name>;AccountKey=<key>;EndpointSuffix=core.windows.net
